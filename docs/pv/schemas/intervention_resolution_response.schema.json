{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictive-validity.local/schemas/intervention_resolution_response.schema.json",
  "title": "PV intervention resolution response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "mention_id", "decision", "components", "unresolved_tokens", "warnings", "review_required"],
  "properties": {
    "schema_version": {"const": "pv.intervention-resolution-response/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "mention_id": {"type": "string", "minLength": 1},
    "decision": {
      "enum": ["resolved_single", "resolved_regimen", "placebo", "non_therapeutic", "ambiguous", "unresolved"]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_span", "candidate_id", "relationship", "resolution_basis", "support"],
        "properties": {
          "source_span": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "relationship": {
            "enum": ["active_component", "background_therapy", "formulation", "salt", "carrier", "targeting_moiety", "payload", "device_component"]
          },
          "resolution_basis": {
            "enum": ["exact_identifier", "explicit_alias_in_supplied_source", "explicit_component_in_supplied_source", "independent_source_corroboration"]
          },
          "support": {
            "type": "array",
            "items": {"$ref": "#/$defs/support"},
            "minItems": 1
          }
        }
      }
    },
    "unresolved_tokens": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "review_required": {"type": "boolean"}
  },
  "$defs": {
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "quote", "start", "end"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"enum": ["resolved_single", "resolved_regimen"]}}},
      "then": {"properties": {"components": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"decision": {"enum": ["placebo", "non_therapeutic", "unresolved"]}}},
      "then": {"properties": {"components": {"maxItems": 0}}}
    }
  ]
}
