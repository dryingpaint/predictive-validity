{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictive-validity.local/schemas/intervention_resolution_request.schema.json",
  "title": "PV intervention resolution request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "source_record_version_id", "trial", "mention", "deterministic_candidates", "evidence_snippets", "allowed_decisions"],
  "properties": {
    "schema_version": {"const": "pv.intervention-resolution-request/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "source_record_version_id": {"type": "string", "minLength": 1},
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nct_id", "title", "lead_sponsor", "conditions"],
      "properties": {
        "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
        "title": {"type": "string"},
        "lead_sponsor": {"type": ["string", "null"]},
        "conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mention_id", "name", "description", "other_names", "intervention_type", "arm_labels"],
      "properties": {
        "mention_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "other_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "intervention_type": {"type": "string", "minLength": 1},
        "arm_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "deterministic_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "evidence_snippets": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceSnippet"}
    },
    "allowed_decisions": {
      "type": "array",
      "prefixItems": [
        {"const": "resolved_single"},
        {"const": "resolved_regimen"},
        {"const": "placebo"},
        {"const": "non_therapeutic"},
        {"const": "ambiguous"},
        {"const": "unresolved"}
      ],
      "items": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "preferred_name", "entity_type", "identifiers", "matched_text", "retrieval_basis", "supporting_source_ids"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "preferred_name": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "matched_text": {"type": "string", "minLength": 1},
        "retrieval_basis": {"type": "string", "minLength": 1},
        "supporting_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "evidenceSnippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_record_version_id", "text", "sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_record_version_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
