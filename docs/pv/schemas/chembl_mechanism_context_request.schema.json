{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictive-validity.local/schemas/chembl_mechanism_context_request.schema.json",
  "title": "PV ChEMBL mechanism-context extraction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "subject_key", "asset", "mechanisms"],
  "properties": {
    "packet_version": {"type": "string", "const": "pv.chembl-mechanism-context-request/1.0"},
    "subject_key": {"type": "string", "minLength": 1},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "preferred_name", "chembl_ids"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "preferred_name": {"type": "string", "minLength": 1},
        "chembl_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_mechanism_id", "mec_id", "asset_target_assertion_id", "target_entity_id", "canonical_target_name", "target_level", "components", "source_record_version_ids", "source_items"],
        "properties": {
          "source_mechanism_id": {"type": "string", "minLength": 1},
          "mec_id": {"type": "integer"},
          "asset_target_assertion_id": {"type": "integer"},
          "target_entity_id": {"type": "string", "minLength": 1},
          "canonical_target_name": {"type": "string", "minLength": 1},
          "target_level": {"enum": ["protein", "protein_family", "protein_complex", "nucleic_acid", "pathogen_target", "other"]},
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_entity_id", "gene_symbol", "protein_name", "uniprot_accession"],
              "properties": {
                "target_entity_id": {"type": ["string", "null"]},
                "gene_symbol": {"type": ["string", "null"]},
                "protein_name": {"type": ["string", "null"]},
                "uniprot_accession": {"type": ["string", "null"]}
              }
            }
          },
          "source_record_version_ids": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
          "source_items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_path", "text", "source_record_version_id"],
              "properties": {
                "source_path": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "source_record_version_id": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  }
}
