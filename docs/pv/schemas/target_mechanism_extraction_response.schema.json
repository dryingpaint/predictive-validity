{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictive-validity.local/schemas/target_mechanism_extraction_response.schema.json",
  "title": "PV target and mechanism extraction response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "passage_id", "assertions", "warnings", "review_required"],
  "properties": {
    "schema_version": {"const": "pv.target-mechanism-extraction-response/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "passage_id": {"type": "string", "minLength": 1},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_kind", "subject_candidate_id", "object_candidate_id", "literal_predicate", "normalized_action", "role", "directness", "support"],
        "properties": {
          "assertion_kind": {"enum": ["molecular_target", "broader_mechanism", "unknown_mechanism"]},
          "subject_candidate_id": {"type": "string", "minLength": 1},
          "object_candidate_id": {"type": ["string", "null"]},
          "literal_predicate": {"type": "string", "minLength": 1},
          "normalized_action": {"enum": ["binds", "inhibits", "antagonizes", "agonizes", "degrades", "stabilizes", "replaces", "silences", "edits", "scavenges", "chelates", "reduces", "potentiates", "modulates", "unknown"]},
          "role": {"enum": ["therapeutic_primary", "secondary", "off_target", "delivery_target", "payload_target", "biomarker", "unknown"]},
          "directness": {"enum": ["direct", "claimed_direct", "indirect", "disputed", "unknown"]},
          "support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "start", "end"],
              "properties": {
                "quote": {"type": "string", "minLength": 1},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "review_required": {"type": "boolean"}
  }
}
