{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictive-validity.local/schemas/chembl_mechanism_context_response.schema.json",
  "title": "PV ChEMBL mechanism-context extraction response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_key", "mechanisms", "warnings", "review_required"],
  "properties": {
    "schema_version": {"type": "string", "const": "pv.chembl-mechanism-context-response/1.0"},
    "subject_key": {"type": "string", "minLength": 1},
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_mechanism_id", "target_entity_id", "canonical_target_name", "target_level", "target_contexts", "specific_gene_targets", "component_membership_is_target_evidence", "warnings"],
        "properties": {
          "source_mechanism_id": {"type": "string", "minLength": 1},
          "target_entity_id": {"type": "string", "minLength": 1},
          "canonical_target_name": {"type": "string", "minLength": 1},
          "target_level": {"enum": ["protein", "protein_family", "protein_complex", "nucleic_acid", "pathogen_target", "other"]},
          "target_contexts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context_type", "normalized_name", "source_path", "quote"],
              "properties": {
                "context_type": {"enum": ["subfamily", "binding_site", "domain", "subunit", "isoform", "mutation_state", "other"]},
                "normalized_name": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          },
          "specific_gene_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_entity_id", "symbol", "source_path", "quote"],
              "properties": {
                "target_entity_id": {"type": "string", "minLength": 1},
                "symbol": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          },
          "component_membership_is_target_evidence": {"type": "boolean", "const": false},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "review_required": {"type": "boolean"}
  }
}
