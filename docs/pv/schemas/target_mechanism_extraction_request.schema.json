{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictive-validity.local/schemas/target_mechanism_extraction_request.schema.json",
  "title": "PV target and mechanism extraction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "source_record_version_id", "passage", "subjects", "object_candidates", "allowed_actions"],
  "properties": {
    "schema_version": {"const": "pv.target-mechanism-extraction-request/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "source_record_version_id": {"type": "string", "minLength": 1},
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passage_id", "text", "sha256"],
      "properties": {
        "passage_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "subjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/entityCandidate"},
      "minItems": 1
    },
    "object_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/entityCandidate"}
    },
    "allowed_actions": {
      "type": "array",
      "items": {"enum": ["binds", "inhibits", "antagonizes", "agonizes", "degrades", "stabilizes", "replaces", "silences", "edits", "scavenges", "chelates", "reduces", "potentiates", "modulates", "unknown"]},
      "uniqueItems": true
    }
  },
  "$defs": {
    "entityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "preferred_name", "entity_type", "identifiers"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "preferred_name": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1},
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "value"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
