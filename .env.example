# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Neon Postgres — ask a maintainer for credentials, or provision your own
# and run `python db/migrate.py init` against it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ANTHROPIC_API_KEY is required by the pipeline's LLM steps (pipeline/llm.py,
# `make all`).
# ANTHROPIC_API_KEY=sk-ant-...
