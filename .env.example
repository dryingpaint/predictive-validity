# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Neon Postgres — ask a maintainer for credentials, or provision your own
# and run db/01_schema.sql against it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ANTHROPIC_API_KEY is required by the pipeline's LLM steps (pipeline/llm.py,
# `make all`); OPENAI_API_KEY by the trial-stoppage rescore in
# analyses/classifiers/ (rescore_trial_stoppage.py).
# See analyses/classifiers/README.md for cost estimates and rerun procedure.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
